# Database — Neon PostgreSQL in production (Vercel + worker share this URL).
# Locally you may use SQLite with an absolute file path if needed:
#   DATABASE_URL="file:/absolute/path/to/schoolpulse/prisma/dev.db"
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# NeverSkip API base (used by token client fallback and browser session API retry)
NEVERSKIP_BASE_URL="https://nskapi.neverskip.com"

# Optional token-based fallback only (do NOT commit real tokens). Prefer browser sync.
NEVERSKIP_TOKEN=""

# ---------------------------------------------------------------------------
# Browser collector / external worker (NOT Vercel serverless)
# ---------------------------------------------------------------------------
# Vercel Hobby hosts the Next.js app only. The 4-hour NeverSkip sync runs on a
# dedicated worker host with Playwright + a persisted browser profile.
#
# FIRST TIME (headed, complete CAPTCHA normally):
#   npm run neverskip:login
# ONE-SHOT sync:
#   npm run sync:neverskip:browser
# LONG-RUNNING worker (default every 4 hours):
#   npm run worker:neverskip
#
# Session files live in NEVERSKIP_PROFILE_DIR (gitignored — NEVER commit).
NEVERSKIP_PORTAL_URL="https://parent.neverskip.com"
NEVERSKIP_NOTICES_PAGE_URL="https://parent.neverskip.com/default/dailynotice"
NEVERSKIP_HOMEWORK_PAGE_URL="https://parent.neverskip.com/default/assignment"
NEVERSKIP_PROFILE_DIR=".playwright-profile"
# Sync defaults to headless. Set to false only if you need to watch the browser.
# Local tip: Incapsula may block headless Chromium — use NEVERSKIP_HEADLESS=false for local sync.
# NEVERSKIP_HEADLESS="false"
# Worker cadence (outside Vercel). Default is 4 hours.
NEVERSKIP_SYNC_INTERVAL_HOURS="4"
# Or set exact milliseconds (overrides hours):
# NEVERSKIP_SYNC_INTERVAL_MS="14400000"
# Run a sync immediately when the worker process starts (default true).
NEVERSKIP_WORKER_RUN_ON_START="true"
# Safe envelope debug (keys/counts only). Set to 0 to disable.
NEVERSKIP_DEBUG="1"

# Optional: protects GET/POST /api/cron/neverskip-sync (token HTTP fallback only).
# This route is NOT scheduled by Vercel Cron. Do not add vercel.json crons
# more than once per day — Vercel Hobby will reject the deployment.
CRON_SECRET=""

# Existing Google Sheets integrations (optional)
NEXT_PUBLIC_UPDATES_SHEET_URL=""
NEXT_PUBLIC_HOMEWORK_SHEET_GID=""

# AI chat (optional)
OPENAI_API_KEY=""

# ---------------------------------------------------------------------------
# Parent Auth.js (Credentials) — required for acknowledgements
# ---------------------------------------------------------------------------
# Generate: openssl rand -base64 32
AUTH_SECRET=""
# Optional local URL for Auth.js
# AUTH_URL="http://localhost:3000"

# Seed a parent user (hashed password stored in Postgres — never commit real passwords):
#   SEED_PARENT_EMAIL=parent@example.com SEED_PARENT_PASSWORD='********' npx tsx scripts/seed-parent-user.ts
SEED_PARENT_EMAIL=""
SEED_PARENT_PASSWORD=""
SEED_PARENT_NAME="Parent"
