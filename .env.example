# Database — use an absolute file path locally to avoid cwd resolution issues with Next.js
# Example: DATABASE_URL="file:/absolute/path/to/schoolpulse/prisma/dev.db"
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# NeverSkip API base (used by token client fallback and browser session API retry)
NEVERSKIP_BASE_URL="https://nskapi.neverskip.com"

# Optional token-based fallback only (do NOT commit real tokens). Prefer browser sync.
NEVERSKIP_TOKEN=""

# Browser collector (local / dedicated worker — not Vercel serverless)
# FIRST TIME: npm run neverskip:login  (headed; complete CAPTCHA normally)
# LATER:      npm run sync:neverskip:browser  (headless; reuses persisted profile)
# Session files live in .playwright-profile/ (gitignored — NEVER commit).
NEVERSKIP_PORTAL_URL="https://parent.neverskip.com"
NEVERSKIP_NOTICES_PAGE_URL="https://parent.neverskip.com/default/dailynotice"
NEVERSKIP_HOMEWORK_PAGE_URL="https://parent.neverskip.com/default/assignment"
NEVERSKIP_PROFILE_DIR=".playwright-profile"
# Sync defaults to headless. Set to false only if you need to watch the browser.
# NEVERSKIP_HEADLESS="false"
# Safe envelope debug (keys/counts only). Set to 0 to disable.
NEVERSKIP_DEBUG="1"

# Protects GET/POST /api/cron/neverskip-sync (token fallback path)
CRON_SECRET=""

# Existing Google Sheets integrations (optional)
NEXT_PUBLIC_UPDATES_SHEET_URL=""
NEXT_PUBLIC_HOMEWORK_SHEET_GID=""

# AI chat (optional)
OPENAI_API_KEY=""
