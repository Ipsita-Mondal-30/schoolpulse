# Every 4 hours (00,04,08,12,16,20 host time). Persistent=true runs a missed slot after reboot.
[Unit]
Description=SchoolPulse NeverSkip sync every 4 hours

[Timer]
OnCalendar=*-*-* 00/4:00:00
Persistent=true
RandomizedDelaySec=60
Unit=schoolpulse-neverskip-sync.service

[Install]
WantedBy=timers.target
