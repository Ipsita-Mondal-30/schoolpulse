# Local secrets for docker compose / Oracle worker (never commit).
# Copy to .env next to docker-compose.yml:
#   cp .env.example .env

DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# REQUIRED for production cache correctness after sync:
# Use the SAME Redis URL as Vercel SchoolPulse so invalidateSchoolPulseCaches
# clears parent-facing homework/notices/jol/updates/this-week keys.
# Without REDIS_URL, Neon still updates but Vercel may serve stale Redis until TTL.
# REDIS_URL=rediss://:...

# Admin email alerts (Supabase Edge Function relay: supabase/functions/schoolpulse-sync-alert).
# Sent only on state change: auth expired, no COMPLETE sync 6h+, repeated failures,
# incomplete critical data — plus one recovery email. If unset, the worker logs
# "ALERT NOT SENT — email unconfigured". If the whole VM is down nothing is emailed;
# monitor GET /api/admin/sync-health (503 when unhealthy) externally as the backstop.
# SUPABASE_ALERT_FUNCTION_URL=https://<project>.supabase.co/functions/v1/schoolpulse-sync-alert
# SUPABASE_ALERT_FUNCTION_KEY=<ALERT_RELAY_KEY set in Supabase secrets>
# ALERT_EMAIL_TO=admin@example.com

# Optional overrides:
# NEVERSKIP_HEADLESS=true
# NEVERSKIP_DATA_DIR=/var/lib/schoolpulse/data
# NEVERSKIP_PORTAL_URL=https://parent.neverskip.com
# NEVERSKIP_BASE_URL=https://nskapi.neverskip.com
